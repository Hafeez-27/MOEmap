# Copy to .env and fill in. Never commit .env. On Vercel, add the same names as (sensitive) environment variables.

# Site
MAP_PASSWORD=            # the one shared password for the map
SITE_URL=                # public address, e.g. https://moe-map.antm.ai (used in email links)

# Google Maps Platform (Routes API + Map Tiles API enabled on the key)
GOOGLE_MAPS_API_KEY=

# AI: Ollama answers questions, Claude plans changes
OLLAMA_HOST=https://ollama.com
OLLAMA_KEY=
OLLAMA_MODEL=gpt-oss:120b
CLAUDE_KEY=              # Anthropic API key (Console)
# CLAUDE_MODEL=claude-sonnet-5-5
# CLAUDE_EFFORT=         # leave empty: medium for simple changes, high for options / several changes

# Email approvals (Resend) and storage (Vercel Blob, private store)
RESEND_KEY=
APPROVAL_SECRET=         # long random string; signs the approve/reject links
BLOB_READ_WRITE_TOKEN=   # set by `vercel env pull` into deploy/moe-option-remote-map/.env.local
# APPROVERS=name@example.com:Full Name,other@example.com:Other Name

# Local testing only (server.js sets these by default)
# STORE_PREFIX=dev/
# MAIL_TEST_TO=delivered@resend.dev
